---
const steps = [
  {
    number: 1,
    title: "Add Items",
    description: "Add products with quantities and set minimum thresholds",
  },
  {
    number: 2,
    title: "Track Usage",
    description: "Update quantities as you use items at home",
  },
  {
    number: 3,
    title: "Get Your List",
    description: "Shopping list auto-generates when stock runs low",
  },
  {
    number: 4,
    title: "Check In",
    description: "One tap after shopping updates your inventory",
  },
];
---

<!-- HowItWorks: Displays a simple 4-step flow showing how Stocksy works -->
<section class="bg-card py-16 lg:py-24">
  <div class="container mx-auto max-w-5xl px-4">
    <div class="mb-12 text-center">
      <h2 class="mb-4 text-2xl font-semibold text-foreground lg:text-3xl">How it works</h2>
      <p class="mx-auto max-w-2xl text-muted-foreground">
        Get started in minutes and never run out of essentials again.
      </p>
    </div>

    <!-- Desktop: Horizontal flow -->
    <div class="hidden md:block">
      <div class="relative flex items-start justify-between">
        <!-- Connecting line -->
        <div class="absolute left-0 right-0 top-7 h-0.5 bg-border" style="left: 10%; right: 10%;" aria-hidden="true">
        </div>

        {
          steps.map((step) => (
            <div class="relative flex w-1/4 flex-col items-center text-center">
              <div class="relative z-10 mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary text-xl font-bold text-primary-foreground shadow-sm">
                {step.number}
              </div>
              <h3 class="mb-2 font-semibold text-foreground">{step.title}</h3>
              <p class="text-sm text-muted-foreground">{step.description}</p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Mobile: Vertical flow -->
    <div class="md:hidden">
      <div class="relative space-y-8">
        <!-- Connecting line -->
        <div class="absolute bottom-8 left-7 top-8 w-0.5 bg-border" aria-hidden="true"></div>

        {
          steps.map((step) => (
            <div class="relative flex items-start gap-4">
              <div class="relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-primary text-xl font-bold text-primary-foreground shadow-sm">
                {step.number}
              </div>
              <div class="pt-2">
                <h3 class="mb-1 font-semibold text-foreground">{step.title}</h3>
                <p class="text-sm text-muted-foreground">{step.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
