---
/**
 * LandingFooter Component
 *
 * Minimal footer for the landing page with copyright notice.
 */
const currentYear = new Date().getFullYear();
---

<footer class="border-t bg-background py-8">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <p class="text-sm text-muted-foreground">
        © {currentYear} Stocksy. All rights reserved.
      </p>
      <nav class="flex gap-6 text-sm text-muted-foreground" aria-label="Footer navigation">
        <a href="/login" class="transition-colors hover:text-foreground">Login</a>
        <a href="/register" class="transition-colors hover:text-foreground">Sign Up</a>
      </nav>
    </div>
  </div>
</footer>
